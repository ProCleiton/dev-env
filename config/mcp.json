{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/nordeste-fomento",
      "auth": "oauth",
      "oauth": {
        "clientName": "oh-my-pi"
      }
    },
    "graylog": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/home/dev/.local/lib/graylog-mcp/node_modules/mcp-server-graylog/src/index.js"
      ],
      "env": {
        "BASE_URL": "${GRAYLOG_URL}",
        "API_TOKEN": "${GRAYLOG_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": ["--headless", "--isolated"]
    }
  }
}
